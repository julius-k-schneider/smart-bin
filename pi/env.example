# Smart-Bin configuration (example)
# ------------------------------------------------------------------
# On the Pi this file lives as ~/.kiconnect.env (chmod 600) and is loaded
# at program start (via the systemd service or ~/.bashrc):
#     source ~/.kiconnect.env
# To use: fill in the values, copy the file to ~/.kiconnect.env.

# --- AI API (KIConnect NRW) ---
# API key from your KIConnect account (format: <id>:<secret>)
export KICONNECT_API_KEY='YOUR_API_KEY_HERE'

# Vision-capable model for image classification
export KICONNECT_MODEL='Mistral Small 3-2-24b Instruct KI:Inferenz.nrw'

# API base URL (the code default is identical; kept here for completeness)
export KICONNECT_BASE_URL='https://chat.kiconnect.nrw/api/v1'

# --- Camera ---
# Network camera (phone app "IP Webcam"): the phone's snapshot URL.
# Adjust IP + port to your phone/network. Empty/omitted -> CSI camera.
export CAMERA_URL='http://192.168.226.214:8080/shot.jpg'

# --- Dashboard (scripts/backend.py) ---
# Ingest WebSocket of the dashboard backend. Use the IP of the machine running
# the backend - not localhost, the Pi has to reach it over the network.
export SMART_BIN_WS_URL='ws://192.168.0.10:8181/ws/ingest'

# Which bin this Pi reports as. Must already exist in the dashboard.
export SMART_BIN_ID='CGN-001'

# Shared secret, must match SMART_BIN_INGEST_TOKEN on the backend.
# Leave empty on both sides to disable the check (local demo only).
export SMART_BIN_INGEST_TOKEN=''
